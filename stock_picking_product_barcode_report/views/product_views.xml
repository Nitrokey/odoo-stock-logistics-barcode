<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="product_packaging_tree_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_tree_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="print_one_label_by_item" optional="show" />
            </field>
        </field>
    </record>

    <record id="product_packaging_form_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view" />
        <field name="arch" type="xml">
            <field name="barcode" position="after">
                <field name="print_one_label_by_item" />
            </field>
        </field>
    </record>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <button name="action_open_label_layout" position="after">
                <button
                    string="Barcode Labels"
                    type="object"
                    name="action_open_barcode_label_wizard"
                    invisible="type == 'service'"
                    groups="stock.group_stock_user"
                />
            </button>
        </field>
    </record>
</odoo>
